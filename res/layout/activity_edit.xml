<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 工具栏：等宽 6 列，两行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card"
        android:elevation="2dp"
        android:paddingTop="1dp">

        <LinearLayout
            android:id="@+id/row_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:background="#EFEFF2" />

        <LinearLayout
            android:id="@+id/row_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="1dp" />
    </LinearLayout>

    <!-- 状态条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F5F6F8"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/swatch"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@color/line_annotation" />

        <TextView
            android:id="@+id/tv_style"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="2.2dp 实线"
            android:textSize="11.5sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="单位 m"
            android:textSize="11.5sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="未标定"
            android:textSize="11.5sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.meownote.measure.AnnotationView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 选中标注时出现的操作条 -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E8F1FD"
        android:paddingLeft="14dp"
        android:paddingRight="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/sel_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#1E3A6B"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <Button
            android:id="@+id/sel_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="编辑"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#1E6FD9"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/sel_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="删除"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#D93025"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:text="拖动画线→输入尺寸；点标注可选中拖动，再点一下可修改" />
</LinearLayout>
